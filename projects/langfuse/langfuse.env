# Secrets for compose.yml, as Vault references (resolved by ./up.sh).
# NAME=vault:<mount>/<path>#<field>. Nothing secret is committed.
POSTGRES_PASSWORD=vault:kv/laptop/langfuse#POSTGRES_PASSWORD
CLICKHOUSE_PASSWORD=vault:kv/laptop/langfuse#CLICKHOUSE_PASSWORD
REDIS_AUTH=vault:kv/laptop/langfuse#REDIS_AUTH
MINIO_ROOT_PASSWORD=vault:kv/laptop/langfuse#MINIO_ROOT_PASSWORD
SALT=vault:kv/laptop/langfuse#SALT
ENCRYPTION_KEY=vault:kv/laptop/langfuse#ENCRYPTION_KEY
NEXTAUTH_SECRET=vault:kv/laptop/langfuse#NEXTAUTH_SECRET
LANGFUSE_PUBLIC_KEY=vault:kv/laptop/langfuse#PUBLIC_KEY
LANGFUSE_SECRET_KEY=vault:kv/laptop/langfuse#SECRET_KEY
LANGFUSE_INIT_USER_EMAIL=vault:kv/laptop/langfuse#USER_EMAIL
LANGFUSE_INIT_USER_PASSWORD=vault:kv/laptop/langfuse#USER_PASSWORD
