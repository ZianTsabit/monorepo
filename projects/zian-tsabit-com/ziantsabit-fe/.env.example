# Copy to .env (which is gitignored) to point the SPA at a different backend.
# Unset, the app falls back to http://localhost:8000/api.
#
# Whatever origin serves this SPA must also be listed in the backend's
# CORS_ALLOWED_ORIGINS, or the browser rejects every response.
VITE_API_BASE_URL=http://localhost:8000/api

# Vite resolves this when the bundle is *built*, not when it is served, so a
# container image has it baked in. docker-compose.prod.yml reads this same .env
# and passes the value as a build arg; changing it needs a rebuild, not a
# restart.
