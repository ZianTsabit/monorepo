# Copy to .env (gitignored). docker-compose.yml does not read this file -- it
# passes its own development values directly as `environment:` -- but a bare
# `./gradlew bootRun` does not read it either, so load it into the shell
# first: `set -a; source .env; set +a`.
#
# docker-compose.prod.yml DOES read it, but for a different and much shorter set
# of names -- see the PRODUCTION section at the bottom. Those are interpolated
# into the compose file rather than passed to the app directly, which is why
# they are not the same names as the ones above them.

# Postgres is the only backend; there is no embedded fallback. These match the
# `db` service in docker-compose.yml.
POSTGRES_DB=zian_tsabit_be
POSTGRES_USER=zian_tsabit_be
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# TLS for the database connection. Unset means the driver's default, 'prefer',
# which silently falls back to plaintext when the server has no TLS -- fine for
# the `db` service beside this one, not fine across a network. See
# docker-compose.external-db.yml.
#   require      encrypt, but do not check who answered
#   verify-full  encrypt and authenticate the server; needs the CA below
# POSTGRES_SSLMODE=
# Path *inside the container* to the CA that signed the server certificate, so
# the file has to be mounted in. Only read for verify-ca / verify-full.
# POSTGRES_SSLROOTCERT=

# Create this account on startup if it does not exist yet -- the replacement for
# `manage.py createsuperuser`. An existing account is never modified, and one
# carried over from the Django backend keeps its password.
# ADMIN_USERNAME=
# ADMIN_PASSWORD=

# Uploaded post images go to an S3-compatible bucket. These match the `rustfs`
# service in docker-compose.yml; `storage-init` beside it creates the bucket and
# makes it public-read. Running the API outside Docker needs
# `docker compose up rustfs storage-init` (or any S3) reachable at the endpoint
# below.
AWS_STORAGE_BUCKET_NAME=ziantsabit-media
AWS_S3_ACCESS_KEY_ID=rustfsadmin
AWS_S3_SECRET_ACCESS_KEY=rustfsadmin
# API -> storage. Inside Docker this is http://rustfs:9000.
AWS_S3_ENDPOINT_URL=http://localhost:9000
# browser -> storage, i.e. what ends up in every image URL. Only differs from
# the line above when the API reaches the bucket by a name the browser cannot,
# which is exactly the case inside Docker.
# AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
# MAX_UPLOAD_SIZE=10485760

# Space-separated. DJANGO_ALLOWED_HOSTS is still read as a fallback.
# ALLOWED_HOSTS=localhost 127.0.0.1 [::1]
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# CSRF_TRUSTED_ORIGINS=http://localhost:5173
# Take the scheme and client address from X-Forwarded-* -- set to `native` only
# behind a proxy, since a client can send those headers too.
# FORWARD_HEADERS_STRATEGY=none

# What a *stranger* may write, per client address: leaving a comment, and
# tapping a reaction. "<number>/<second|minute|hour|day>". Counted in memory, so
# a restart resets them.
# COMMENT_RATE_LIMIT=20/hour
# REACTION_RATE_LIMIT=60/min


# PRODUCTION
# ----------
# These are read by docker-compose.prod.yml (Compose reads .env automatically)
# and interpolated into the service definitions. Compose refuses to start if any
# is missing, rather than quietly deploying a development default. The names
# are unchanged from the Django deployment, so its .env works as-is.
#
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build

# POSTGRES_PASSWORD=
# RUSTFS_ACCESS_KEY=
# RUSTFS_SECRET_KEY=
# The API's own hostname, space-separated. Not the site's.
# DJANGO_ALLOWED_HOSTS=api.example.com
# The origin(s) serving the SPA. Fills both CORS_ALLOWED_ORIGINS and
# CSRF_TRUSTED_ORIGINS.
# SITE_ORIGINS=https://example.com https://www.example.com
# browser -> object storage. Written into the stored URL of every upload, so
# settle on it before the first one: changing it later 404s every image already
# published.
# MEDIA_ORIGIN=https://media.example.com
# DJANGO_SECRET_KEY is no longer read: sessions are stored server-side and the
# CSRF token is random, so nothing is signed with it. It can stay in .env.

# Only with docker-compose.external-db.yml, i.e. a Postgres that is not the `db`
# service. POSTGRES_HOST is required by that file; the rest have defaults.
# POSTGRES_HOST=10.0.0.50
# POSTGRES_PORT=5432
# POSTGRES_DB=zian_tsabit_be
# POSTGRES_USER=zian_tsabit_be
# Defaults to `require` there. Raise it to verify-full and mount the CA to
# authenticate the server as well as encrypt.
# POSTGRES_SSLMODE=require
# POSTGRES_SSLROOTCERT=/etc/ssl/postgres-ca.crt
