# The API's production settings; merged over ../../base/ziantsabit-be.env.
# KEY=value, no quotes.

POSTGRES_DB=zian_tsabit_be
POSTGRES_USER=zian_tsabit_be

AWS_STORAGE_BUCKET_NAME=ziantsabit-media
# browser -> storage, written into the stored URL of every upload. Must stay
# what it was under compose, or every image already published 404s.
AWS_S3_PUBLIC_ENDPOINT_URL=https://media.ziantsabit.com

ALLOWED_HOSTS=api.ziantsabit.com
CORS_ALLOWED_ORIGINS=https://ziantsabit.com https://www.ziantsabit.com
CSRF_TRUSTED_ORIGINS=https://ziantsabit.com https://www.ziantsabit.com
