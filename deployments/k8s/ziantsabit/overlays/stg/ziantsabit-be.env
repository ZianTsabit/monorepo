# The API's staging settings; merged over ../../base/ziantsabit-be.env.
# KEY=value, no quotes.
#
# Same Postgres and RustFS servers as prod, but never the same data: its own
# database, user and bucket, all created by hand (see ../../README.md).

# Underscores, not hyphens: a hyphenated name has to be double-quoted in every
# SQL statement that mentions it.
POSTGRES_DB=stg_zian_tsabit_be
POSTGRES_USER=stg_zian_tsabit_be

AWS_STORAGE_BUCKET_NAME=stg-ziantsabit-media
# browser -> storage, written into the stored URL of every upload. Staging has
# no media hostname, so this is RustFS itself; the bucket must be public-read.
AWS_S3_PUBLIC_ENDPOINT_URL=http://192.168.0.111:9000

# Staging is reached on the LAN by node IP and NodePort (see kustomization.yaml),
# not through the tunnel. ALLOWED_HOSTS matches the host without its port; the
# origins are exactly what the browser's address bar shows.
ALLOWED_HOSTS=192.168.0.150 192.168.0.151 192.168.0.152
CORS_ALLOWED_ORIGINS=http://192.168.0.150:30080
CSRF_TRUSTED_ORIGINS=http://192.168.0.150:30080

# Plain HTTP: a browser drops Secure cookies sent over it, which would break the
# admin login and every CSRF-checked write.
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# Every LAN device is a private address, so `native` would let any of them set
# its own X-Forwarded-For and dodge the rate limits. Nothing sits in front of
# the API here, so the caller's own address is the right one.
FORWARD_HEADERS_STRATEGY=none