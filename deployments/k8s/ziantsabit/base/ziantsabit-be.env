# The API's settings that are the same in every environment, under the app's
# own variable names (not the compose names the backend's config/*.env use --
# there is no run.sh here to map one onto the other). Each overlay's
# ziantsabit-be.env adds the rest. Credentials go in the hand-made Secret.
#
# KEY=value, one per line, the rest of the line is the value: no quotes.

# Services in external.yaml, which hold the real addresses. Both environments
# use the same two servers, with their own database and bucket on each.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# `require` encrypts without checking the server. For verify-full, put the CA
# in a Secret, mount it at /etc/ssl/postgres-ca.crt and add
# POSTGRES_SSLROOTCERT pointing there -- and the server's certificate must
# then name `postgres`, or POSTGRES_HOST must go back to the name it has.
POSTGRES_SSLMODE=require

# API -> storage, as a pod reaches it. Must be set: the default is
# localhost:9000, which inside a pod is the pod itself.
AWS_S3_ENDPOINT_URL=http://rustfs:9000

SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
# Trust X-Forwarded-* from a private address. Safe only because the Service
# is ClusterIP and the one thing calling it is cloudflared
# (../cloudflared/cloudflared.yaml), which forwards the visitor's address.
# Routing through Traefik instead would replace that header with cloudflared's
# pod IP unless Traefik is told to trust it, collapsing every visitor into one
# rate-limit bucket.
FORWARD_HEADERS_STRATEGY=native
